# Salin menjadi .env.local lalu isi nilainya.
# Lokal  : lihat output `npx supabase status`
# Online : Supabase Dashboard > Project Settings > API Keys

# ---- Publik (boleh terlihat di browser) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key
# Cloudflare Turnstile site key. Nilai di bawah = kunci UJI resmi (selalu lolos).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- RAHASIA (hanya server; JANGAN diberi awalan NEXT_PUBLIC_) ------------
# service_role / secret key Supabase — hanya dipakai untuk pengajuan klaim & rate limit.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-atau-secret-key
# Cloudflare Turnstile secret key. Nilai di bawah = kunci UJI resmi (selalu lolos).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Untuk hash IP/email di rate limit. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=ganti-dengan-64-karakter-acak
